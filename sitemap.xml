---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!-- 首頁 -->
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- 遍歷全部靜態頁面，兼容美化URL，自動過濾首頁 -->
  {% for page in site.pages %}
    {% assign pageUrl = page.url | strip %}
    {% if pageUrl != "/" and pageUrl != "/index.html" %}
    <url>
      <loc>{{ site.url }}{{ site.baseurl }}{{ pageUrl | xml_escape }}</loc>
      <lastmod>{{ page.lastmod | default: site.time | date_to_xmlschema }}</lastmod>
      <changefreq>monthly</changefreq>
      <priority>0.7</priority>
    </url>
    {% endif %}
  {% endfor %}

  <!-- _posts 博文，沒有博文就保持註解狀態無需刪除 -->
  {% comment %}
  {% for post in site.posts %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ post.url | xml_escape }}</loc>
    <lastmod>{{ post.lastmod | default: post.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {% endfor %}
  {% endcomment %}

</urlset>
